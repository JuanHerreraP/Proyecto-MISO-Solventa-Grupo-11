# Ejemplo de variables; exportarlas al proceso o usar uvicorn --env-file.
APP_ENV=development
WEB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Mantener true en producción (HTTPS). false solo para desarrollo HTTP local.
WEB_COOKIE_SECURE=true
WEB_COOKIE_SAMESITE=lax

# Secreto compartido con la pasarela para firmar (HMAC-SHA256) las confirmaciones de pago.
PAGOS_WEBHOOK_SECRET=cambiar-por-un-secreto-largo
# Billetera (HU07): base pública de los enlaces para compartir certificados y su vigencia.
SOLVENTA_URL_PUBLICA=http://localhost:8000
BILLETERA_ENLACE_HORAS=24

# Firma electrónica (HU14): llave del HMAC de los códigos OTP.
FIRMA_OTP_SECRET=cambiar-por-un-secreto-largo

# Emisión de la póliza (HU12): carpeta donde se guardan los PDF emitidos.
POLIZAS_DOCUMENTOS_DIR=./documentos_polizas
# Opcional: guarda los PDF en S3 y usa el disco como respaldo si S3 no responde.
# POLIZAS_S3_BUCKET=solventa-polizas
# POLIZAS_S3_PREFIJO=polizas
# POLIZAS_S3_ENDPOINT_URL=http://localhost:9000

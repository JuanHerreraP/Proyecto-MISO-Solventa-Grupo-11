{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Solventa Sprint 1: S3/CloudFront, HTTP API, private ALB/ECS, RDS PostgreSQL (db.t3.micro) in two AZs",
  "Parameters": {
    "BackendImage": {
      "Type": "String",
      "Description": "ECR backend image URI with immutable tag"
    },
    "JwtSecretArn": {
      "Type": "String",
      "Description": "Secrets Manager JSON with private_key and public_key PEM"
    },
    "PostgresEngineVersion": {
      "Type": "String",
      "Description": "RDS PostgreSQL engine version (e.g. 16.x); verify with describe-orderable-db-instance-options for db.t3.micro"
    },
    "ApiRateLimit": {
      "Type": "Number",
      "Default": 100,
      "MinValue": 1
    },
    "ApiBurstLimit": {
      "Type": "Number",
      "Default": 200,
      "MinValue": 1
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.42.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true
      }
    },
    "Gateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {}
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "Gateway"
        }
      }
    },
    "PublicRoutes": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRoutes"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "Gateway"
        }
      },
      "DependsOn": "GatewayAttachment"
    },
    "PublicSubnet0": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.42.0.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "PublicSubnet0Route": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicSubnet0"
        },
        "RouteTableId": {
          "Ref": "PublicRoutes"
        }
      }
    },
    "PrivateSubnet0": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.42.10.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "PublicSubnet1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.42.1.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "PublicSubnet1Route": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicSubnet1"
        },
        "RouteTableId": {
          "Ref": "PublicRoutes"
        }
      }
    },
    "PrivateSubnet1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.42.11.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "AlbSg": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "GroupDescription": "Only API Gateway VPC link reaches private ALB",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "SourceSecurityGroupId": {
              "Ref": "VpcLinkSg"
            }
          }
        ]
      }
    },
    "TaskSg": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "GroupDescription": "Only private ALB reaches API",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 8000,
            "ToPort": 8000,
            "SourceSecurityGroupId": {
              "Ref": "AlbSg"
            }
          }
        ]
      }
    },
    "DbSg": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "GroupDescription": "Only ECS tasks can reach PostgreSQL",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "SourceSecurityGroupId": {
              "Ref": "TaskSg"
            }
          }
        ]
      }
    },
    "DbSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "GenerateSecretString": {
          "SecretStringTemplate": "{\"username\":\"solventa\"}",
          "GenerateStringKey": "password",
          "PasswordLength": 40,
          "ExcludePunctuation": true
        }
      }
    },
    "DbSubnets": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "Isolated RDS subnets",
        "SubnetIds": [
          {
            "Ref": "PrivateSubnet0"
          },
          {
            "Ref": "PrivateSubnet1"
          }
        ]
      }
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "DeletionPolicy": "Delete",
      "UpdateReplacePolicy": "Delete",
      "Properties": {
        "Engine": "postgres",
        "EngineVersion": {
          "Ref": "PostgresEngineVersion"
        },
        "DBInstanceClass": "db.t3.micro",
        "AllocatedStorage": "20",
        "DBName": "solventa",
        "MasterUsername": "solventa",
        "MasterUserPassword": {
          "Fn::Sub": "{{resolve:secretsmanager:${DbSecret}:SecretString:password}}"
        },
        "DBSubnetGroupName": {
          "Ref": "DbSubnets"
        },
        "VPCSecurityGroups": [
          {
            "Ref": "DbSg"
          }
        ],
        "StorageEncrypted": true,
        "BackupRetentionPeriod": 1,
        "MultiAZ": false,
        "PubliclyAccessible": false,
        "DeletionProtection": false
      }
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 14
      }
    },
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {}
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
          }
        ],
        "Policies": [
          {
            "PolicyName": "ReadRuntimeSecrets",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": [
                    {
                      "Ref": "JwtSecretArn"
                    },
                    {
                      "Ref": "DbSecret"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "TaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    },
    "LoadBalancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Scheme": "internal",
        "Subnets": [
          {
            "Ref": "AppSubnet0"
          },
          {
            "Ref": "AppSubnet1"
          }
        ],
        "SecurityGroups": [
          {
            "Ref": "AlbSg"
          }
        ]
      },
      "DependsOn": "GatewayAttachment"
    },
    "Targets": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Port": 8000,
        "Protocol": "HTTP",
        "TargetType": "ip",
        "HealthCheckPath": "/salud",
        "Matcher": {
          "HttpCode": "200"
        },
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "30"
          }
        ]
      }
    },
    "Listener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "LoadBalancer"
        },
        "Port": 80,
        "Protocol": "HTTP",
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "Targets"
            }
          }
        ]
      }
    },
    "NoCache": {
      "Type": "AWS::CloudFront::CachePolicy",
      "Properties": {
        "CachePolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-no-cache"
          },
          "DefaultTTL": 0,
          "MinTTL": 0,
          "MaxTTL": 0,
          "ParametersInCacheKeyAndForwardedToOrigin": {
            "CookiesConfig": {
              "CookieBehavior": "none"
            },
            "HeadersConfig": {
              "HeaderBehavior": "none"
            },
            "QueryStringsConfig": {
              "QueryStringBehavior": "none"
            },
            "EnableAcceptEncodingGzip": false
          }
        }
      }
    },
    "ForwardViewer": {
      "Type": "AWS::CloudFront::OriginRequestPolicy",
      "Properties": {
        "OriginRequestPolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-viewer"
          },
          "CookiesConfig": {
            "CookieBehavior": "all"
          },
          "HeadersConfig": {
            "HeaderBehavior": "allExcept",
            "Headers": [
              "host"
            ]
          },
          "QueryStringsConfig": {
            "QueryStringBehavior": "all"
          }
        }
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "HttpVersion": "http2",
          "PriceClass": "PriceClass_100",
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": true
          },
          "Origins": [
            {
              "Id": "web",
              "DomainName": {
                "Fn::GetAtt": [
                  "WebBucket",
                  "RegionalDomainName"
                ]
              },
              "OriginAccessControlId": {
                "Ref": "WebOac"
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              }
            },
            {
              "Id": "api",
              "DomainName": {
                "Fn::Sub": "${HttpApi}.execute-api.${AWS::Region}.${AWS::URLSuffix}"
              },
              "CustomOriginConfig": {
                "HTTPSPort": 443,
                "OriginProtocolPolicy": "https-only",
                "OriginSSLProtocols": [
                  "TLSv1.2"
                ]
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "web",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "CachePolicyId": {
              "Ref": "NoCache"
            },
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {
                  "Fn::GetAtt": [
                    "SpaRewrite",
                    "FunctionARN"
                  ]
                }
              }
            ]
          },
          "CustomErrorResponses": [
            {
              "ErrorCode": 400,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 403,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 404,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 405,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 414,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 416,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 500,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 501,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 502,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 503,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 504,
              "ErrorCachingMinTTL": 0
            }
          ],
          "CacheBehaviors": [
            {
              "TargetOriginId": "api",
              "ViewerProtocolPolicy": "https-only",
              "AllowedMethods": [
                "GET",
                "HEAD",
                "OPTIONS",
                "PUT",
                "POST",
                "PATCH",
                "DELETE"
              ],
              "CachedMethods": [
                "GET",
                "HEAD"
              ],
              "CachePolicyId": {
                "Ref": "NoCache"
              },
              "OriginRequestPolicyId": {
                "Ref": "ForwardViewer"
              },
              "PathPattern": "/api/*"
            },
            {
              "TargetOriginId": "api",
              "ViewerProtocolPolicy": "https-only",
              "AllowedMethods": [
                "GET",
                "HEAD",
                "OPTIONS",
                "PUT",
                "POST",
                "PATCH",
                "DELETE"
              ],
              "CachedMethods": [
                "GET",
                "HEAD"
              ],
              "CachePolicyId": {
                "Ref": "NoCache"
              },
              "OriginRequestPolicyId": {
                "Ref": "ForwardViewer"
              },
              "PathPattern": "/salud"
            },
            {
              "TargetOriginId": "api",
              "ViewerProtocolPolicy": "https-only",
              "AllowedMethods": [
                "GET",
                "HEAD",
                "OPTIONS",
                "PUT",
                "POST",
                "PATCH",
                "DELETE"
              ],
              "CachedMethods": [
                "GET",
                "HEAD"
              ],
              "CachePolicyId": {
                "Ref": "NoCache"
              },
              "OriginRequestPolicyId": {
                "Ref": "ForwardViewer"
              },
              "PathPattern": "/docs*"
            },
            {
              "TargetOriginId": "api",
              "ViewerProtocolPolicy": "https-only",
              "AllowedMethods": [
                "GET",
                "HEAD",
                "OPTIONS",
                "PUT",
                "POST",
                "PATCH",
                "DELETE"
              ],
              "CachedMethods": [
                "GET",
                "HEAD"
              ],
              "CachePolicyId": {
                "Ref": "NoCache"
              },
              "OriginRequestPolicyId": {
                "Ref": "ForwardViewer"
              },
              "PathPattern": "/redoc"
            },
            {
              "TargetOriginId": "api",
              "ViewerProtocolPolicy": "https-only",
              "AllowedMethods": [
                "GET",
                "HEAD",
                "OPTIONS",
                "PUT",
                "POST",
                "PATCH",
                "DELETE"
              ],
              "CachedMethods": [
                "GET",
                "HEAD"
              ],
              "CachePolicyId": {
                "Ref": "NoCache"
              },
              "OriginRequestPolicyId": {
                "Ref": "ForwardViewer"
              },
              "PathPattern": "/openapi.json"
            }
          ]
        }
      },
      "DependsOn": "ApiStage"
    },
    "Task": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "Cpu": "1024",
        "Memory": "2048",
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "TaskRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "kyc-a",
            "Image": {
              "Ref": "BackendImage"
            },
            "Essential": true,
            "Command": [
              "uvicorn",
              "mocks.kyc.provider_a:app",
              "--host",
              "127.0.0.1",
              "--port",
              "8001"
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "kyc-a"
              }
            },
            "HealthCheck": {
              "Command": [
                "CMD",
                "python",
                "-c",
                "import urllib.request; urllib.request.urlopen('http://localhost:8001/health', timeout=3)"
              ],
              "Interval": 15,
              "Timeout": 5,
              "Retries": 5,
              "StartPeriod": 30
            }
          },
          {
            "Name": "kyc-b",
            "Image": {
              "Ref": "BackendImage"
            },
            "Essential": true,
            "Command": [
              "uvicorn",
              "mocks.kyc.provider_b:app",
              "--host",
              "127.0.0.1",
              "--port",
              "8002"
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "kyc-b"
              }
            },
            "HealthCheck": {
              "Command": [
                "CMD",
                "python",
                "-c",
                "import urllib.request; urllib.request.urlopen('http://localhost:8002/health', timeout=3)"
              ],
              "Interval": 15,
              "Timeout": 5,
              "Retries": 5,
              "StartPeriod": 30
            }
          },
          {
            "Name": "kyc-c",
            "Image": {
              "Ref": "BackendImage"
            },
            "Essential": true,
            "Command": [
              "uvicorn",
              "mocks.kyc.provider_c:app",
              "--host",
              "127.0.0.1",
              "--port",
              "8003"
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "kyc-c"
              }
            },
            "HealthCheck": {
              "Command": [
                "CMD",
                "python",
                "-c",
                "import urllib.request; urllib.request.urlopen('http://localhost:8003/health', timeout=3)"
              ],
              "Interval": 15,
              "Timeout": 5,
              "Retries": 5,
              "StartPeriod": 30
            }
          },
          {
            "Name": "backend",
            "Image": {
              "Ref": "BackendImage"
            },
            "Essential": true,
            "Environment": [
              {
                "Name": "APP_ENV",
                "Value": "production"
              },
              {
                "Name": "DB_HOST",
                "Value": {
                  "Fn::GetAtt": [
                    "Database",
                    "Endpoint.Address"
                  ]
                }
              },
              {
                "Name": "WEB_ALLOWED_ORIGINS",
                "Value": {
                  "Fn::Sub": "https://${Distribution.DomainName}"
                }
              },
              {
                "Name": "WEB_COOKIE_SECURE",
                "Value": "true"
              },
              {
                "Name": "KYC_PROVIDER",
                "Value": "A"
              },
              {
                "Name": "KYC_PROVIDER_A_URL",
                "Value": "http://127.0.0.1:8001"
              },
              {
                "Name": "KYC_PROVIDER_B_URL",
                "Value": "http://127.0.0.1:8002"
              },
              {
                "Name": "KYC_PROVIDER_C_URL",
                "Value": "http://127.0.0.1:8003"
              }
            ],
            "Secrets": [
              {
                "Name": "DB_PASSWORD",
                "ValueFrom": {
                  "Fn::Sub": "${DbSecret}:password::"
                }
              },
              {
                "Name": "JWT_PRIVATE_KEY_PEM",
                "ValueFrom": {
                  "Fn::Sub": "${JwtSecretArn}:private_key::"
                }
              },
              {
                "Name": "JWT_PUBLIC_KEY_PEM",
                "ValueFrom": {
                  "Fn::Sub": "${JwtSecretArn}:public_key::"
                }
              }
            ],
            "DependsOn": [
              {
                "ContainerName": "kyc-a",
                "Condition": "HEALTHY"
              },
              {
                "ContainerName": "kyc-b",
                "Condition": "HEALTHY"
              },
              {
                "ContainerName": "kyc-c",
                "Condition": "HEALTHY"
              }
            ],
            "HealthCheck": {
              "Command": [
                "CMD",
                "python",
                "-c",
                "import urllib.request; urllib.request.urlopen('http://localhost:8000/salud', timeout=3)"
              ],
              "Interval": 15,
              "Timeout": 5,
              "Retries": 5,
              "StartPeriod": 30
            },
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "backend"
              }
            },
            "PortMappings": [
              {
                "ContainerPort": 8000,
                "Protocol": "tcp"
              }
            ]
          }
        ]
      }
    },
    "Service": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Cluster": {
          "Ref": "Cluster"
        },
        "TaskDefinition": {
          "Ref": "Task"
        },
        "DesiredCount": 1,
        "LaunchType": "FARGATE",
        "PlatformVersion": "1.4.0",
        "HealthCheckGracePeriodSeconds": 180,
        "DeploymentConfiguration": {
          "MinimumHealthyPercent": 0,
          "MaximumPercent": 100,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "DISABLED",
            "Subnets": [
              {
                "Ref": "AppSubnet0"
              },
              {
                "Ref": "AppSubnet1"
              }
            ],
            "SecurityGroups": [
              {
                "Ref": "TaskSg"
              }
            ]
          }
        },
        "LoadBalancers": [
          {
            "ContainerName": "backend",
            "ContainerPort": 8000,
            "TargetGroupArn": {
              "Ref": "Targets"
            }
          }
        ]
      },
      "DependsOn": [
        "Listener",
        "Database",
        "AppDefaultRoute0",
        "AppDefaultRoute1",
        "AppSubnetRoute0",
        "AppSubnetRoute1"
      ]
    },
    "AppSubnet0": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.42.20.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        }
      }
    },
    "NatIp0": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc"
      }
    },
    "Nat0": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "NatIp0",
            "AllocationId"
          ]
        },
        "SubnetId": {
          "Ref": "PublicSubnet0"
        }
      },
      "DependsOn": "GatewayAttachment"
    },
    "AppRoutes0": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "AppDefaultRoute0": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "AppRoutes0"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {
          "Ref": "Nat0"
        }
      }
    },
    "AppSubnetRoute0": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "AppSubnet0"
        },
        "RouteTableId": {
          "Ref": "AppRoutes0"
        }
      }
    },
    "AppSubnet1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.42.21.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        }
      }
    },
    "NatIp1": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc"
      }
    },
    "Nat1": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "NatIp1",
            "AllocationId"
          ]
        },
        "SubnetId": {
          "Ref": "PublicSubnet1"
        }
      },
      "DependsOn": "GatewayAttachment"
    },
    "AppRoutes1": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "AppDefaultRoute1": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "AppRoutes1"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {
          "Ref": "Nat1"
        }
      }
    },
    "AppSubnetRoute1": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "AppSubnet1"
        },
        "RouteTableId": {
          "Ref": "AppRoutes1"
        }
      }
    },
    "VpcLinkSg": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "GroupDescription": "API Gateway VPC link ENIs"
      }
    },
    "HttpApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-api"
        },
        "ProtocolType": "HTTP"
      }
    },
    "VpcLink": {
      "Type": "AWS::ApiGatewayV2::VpcLink",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-link"
        },
        "SubnetIds": [
          {
            "Ref": "AppSubnet0"
          },
          {
            "Ref": "AppSubnet1"
          }
        ],
        "SecurityGroupIds": [
          {
            "Ref": "VpcLinkSg"
          }
        ]
      }
    },
    "ApiIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "IntegrationType": "HTTP_PROXY",
        "IntegrationMethod": "ANY",
        "IntegrationUri": {
          "Ref": "Listener"
        },
        "ConnectionType": "VPC_LINK",
        "ConnectionId": {
          "Ref": "VpcLink"
        },
        "PayloadFormatVersion": "1.0",
        "RequestParameters": {
          "overwrite:path": "$request.path"
        },
        "TimeoutInMillis": 30000
      }
    },
    "ApiRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "$default",
        "Target": {
          "Fn::Sub": "integrations/${ApiIntegration}"
        }
      }
    },
    "ApiLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 14
      }
    },
    "ApiStage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "StageName": "$default",
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": {
            "Ref": "ApiBurstLimit"
          },
          "ThrottlingRateLimit": {
            "Ref": "ApiRateLimit"
          }
        },
        "AccessLogSettings": {
          "DestinationArn": {
            "Fn::GetAtt": [
              "ApiLogs",
              "Arn"
            ]
          },
          "Format": "{\"requestId\":\"$context.requestId\",\"status\":\"$context.status\",\"routeKey\":\"$context.routeKey\",\"integrationError\":\"$context.integrationErrorMessage\"}"
        }
      },
      "DependsOn": "ApiRoute"
    },
    "WebBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "WebOac": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-web"
          },
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "SpaRewrite": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-spa"
        },
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "Rewrite frontend routes only; API behaviors do not attach this function",
          "Runtime": "cloudfront-js-2.0"
        },
        "FunctionCode": "function handler(event) { var r = event.request; var last = r.uri.split('/').pop(); if (last.indexOf('.') === -1) r.uri = '/index.html'; return r; }"
      }
    },
    "WebBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "WebBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${WebBucket.Arn}/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "Url": {
      "Value": {
        "Fn::Sub": "https://${Distribution.DomainName}"
      }
    },
    "Cluster": {
      "Value": {
        "Ref": "Cluster"
      }
    },
    "Service": {
      "Value": {
        "Fn::GetAtt": [
          "Service",
          "Name"
        ]
      }
    },
    "Database": {
      "Value": {
        "Ref": "Database"
      }
    },
    "LogGroup": {
      "Value": {
        "Ref": "Logs"
      }
    },
    "WebBucket": {
      "Value": {
        "Ref": "WebBucket"
      }
    },
    "DistributionId": {
      "Value": {
        "Ref": "Distribution"
      }
    },
    "ApiUrl": {
      "Value": {
        "Fn::GetAtt": [
          "HttpApi",
          "ApiEndpoint"
        ]
      }
    }
  }
}

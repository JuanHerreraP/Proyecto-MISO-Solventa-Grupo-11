<?xml version="1.0" encoding="utf-8"?>
<!-- La sesión biométrica no se respalda ni se transfiere a otro dispositivo (API 31+). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="solventa_sesion.xml" />
        <exclude domain="file" path="borradores_siniestro/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="solventa_sesion.xml" />
        <exclude domain="file" path="borradores_siniestro/" />
    </device-transfer>
</data-extraction-rules>

{$SITE_ADDRESS} {
    encode gzip
    handle /api/* {
        reverse_proxy {$API_UPSTREAM:backend:8000}
    }
    handle /salud {
        reverse_proxy {$API_UPSTREAM:backend:8000}
    }
    handle /docs* {
        reverse_proxy {$API_UPSTREAM:backend:8000}
    }
    handle /openapi.json {
        reverse_proxy {$API_UPSTREAM:backend:8000}
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
